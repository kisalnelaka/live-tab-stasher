{
  "manifest_version": 3,
  "name": "Live Tab Stasher",
  "version": "1.1.0",
  "description": "Lightning-fast session manager that stashes tabs and closes them immediately to eliminate RAM consumption.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Live Tab Stasher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
